pipeline {

    agent any

    environment {
        GIT_URL = 'https://github.com/Neueda-Learning/106-Code_Titans.git'
        BRANCH = 'main'
    }

    stages {

        stage('Checkout Source') {
            steps {
                git branch: "${BRANCH}",
                    url: "${GIT_URL}"
            }
        }

        stage('Build Spring Boot') {
            steps {
                dir('backend') {
                    sh 'chmod +x ./mvnw && ./mvnw clean package -DskipTests -B'
                }
            }
        }
       

        stage('Stop Existing Containers') {
            steps {
                dir('backend') {
                    sh 'docker-compose down || true'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('backend') {
                    sh 'docker-compose build --no-cache'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('backend') {
                    sh 'docker-compose up -d'
                }
            }
        }

        stage('Verify') {
            steps {
                sh 'docker ps'
            }
        }
    }
}